rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['focus']);
    }
    match /users/{uid}/data/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // only the owner sees the list of dashboard users and adds or removes them; a teacher can only check her own entry
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'benbritcrm@gmail.com';
    }
    match /admins/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow read, write: if isOwner();
    }
  }
}
